NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Required for yarn db:seed (auto-creates tables) — NOT used by the Next.js app
# Use Session pooler (IPv4) — direct db.[ref].supabase.co is IPv6-only and often fails locally
SUPABASE_DB_PASSWORD="your-database-password"
# Optional: copy host from Dashboard → Settings → Database → Session pooler (faster than auto-discovery)
# SUPABASE_DB_HOST="aws-1-ap-northeast-1.pooler.supabase.com"
# Or paste the full Session pooler URI:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: set to your live URL (e.g. https://yourdomain.com). If unset or still localhost,
# SSLCommerz callbacks use the request host (x-forwarded-host) automatically.
# SSLCommerz — defaults to sandbox testbox/qwerty (care-connect-hub pattern, no account needed)
# SSLCOMMERZ_STORE_ID="testbox"
# SSLCOMMERZ_STORE_PASSWORD="qwerty"
# SSLCOMMERZ_USE_LIVE="false"
SEED_ADMIN_EMAIL="admin@blueberry.local"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_CUSTOMER_EMAIL="customer@blueberry.local"
SEED_CUSTOMER_PASSWORD="Customer123!"
